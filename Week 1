        "        else:\n",
        "            print(\"Mobil tidak ada bensin, jadi tidak bisa bergerak!\")\n",
        "\n",
        "    def isi_bensin(self):\n",
        "        self.liter_bensin = 100\n",
        "        print(\"Bensin mobil sudah terisi penuh!\")\n",
