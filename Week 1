        "# Membuat class Mobil\n",
        "# Mobil tersebut akan menghabiskan 5 liter bensin setiap kilometernya\n",
        "\n",
        "class Mobil:\n",
        "    def __init__(self, jenis, warna, bensin=100):\n",
        "        self.jenis_mobil = jenis\n",
        "        self.warna_mobil = warna\n",
        "        self.liter_bensin = bensin\n",
        "        self.kilometer = 0\n",
        "\n",
        "    def jalan_maju(self, jumlah_km):\n",
        "        if self.liter_bensin > 0:\n",
        "            sisa_bensin = self.liter_bensin - jumlah_km * 5\n",
        "\n",
        "            if sisa_bensin >= 0:\n",
        "                self.kilometer += jumlah_km\n",
        "                self.liter_bensin = sisa_bensin\n",
        "                print(f\"Mobil maju {jumlah_km} km. Posisi mobil sekarang {self.kilometer} km dari titik awal. Bensin tersisa {self.liter_bensin} liter.\")\n",
        "            else:\n",
        "                km_bisa = self.liter_bensin / 5\n",
        "                self.kilometer += km_bisa\n",
        "                print(f\"Bensin tidak cukup! Mobil hanya maju {km_bisa} km. Sekarang mobil di posisi {self.kilometer} km dari titik awal. Bensin sudah habis!\")\n",
        "                self.liter_bensin = 0\n",
        "        else:\n",
        "            print(\"Mobil tidak ada bensin, jadi tidak bisa maju!\")\n",
        "\n",
        "    def jalan_mundur(self, jumlah_km):\n",
        "        if self.liter_bensin > 0:\n",
        "            sisa_bensin = self.liter_bensin - jumlah_km * 5\n",
        "\n",
        "            if sisa_bensin >= 0:\n",
        "                self.kilometer -= jumlah_km\n",
        "                self.liter_bensin = sisa_bensin\n",
        "                print(f\"Mobil mundur {jumlah_km} km. Posisi mobil sekarang {self.kilometer} km dari titik awal. Bensin tersisa {self.liter_bensin} liter.\")\n",
        "            else:\n",
        "                km_bisa = self.liter_bensin / 5\n",
        "                self.kilometer -= km_bisa\n",
        "                print(f\"Bensin tidak cukup! Mobil hanya mundur {km_bisa} km. Sekarang mobil di posisi {self.kilometer} km dari titik awal. Bensin sudah habis!\")\n",
